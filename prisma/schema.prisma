// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// 本地开发。线上 MariaDB 使用 prisma/mysql/schema.prisma。
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Subscriber {
  id            Int            @id @default(autoincrement())
  shop          String // 店铺域名，如 xxx.myshopify.com
  email         String
  receivedCount Int            @default(0)
  createdAt     DateTime       @default(now())
  deliveries    MailDelivery[]

  @@unique([shop, email]) // 同一店铺邮箱不重复
}

model ShopEmailTemplate {
  shop        String @id
  subject     String
  buttonLabel String
  buttonUrl   String
}

model ShopSender {
  shop      String   @id
  fromName  String   @default("")
  fromEmail String
  updatedAt DateTime @updatedAt
}

// 每个店铺只能绑定一个发件域名。更换必须先删除再添加。
model ShopDomain {
  shop      String   @id
  resendId  String
  name      String   @unique
  status    String
  region    String
  records   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 新店铺的初始额度。修改这一行即可，不必改代码。
model AppSetting {
  key   String @id
  value String
}

// 可购买的邮件包。价格以美分为单位，例如 100 表示 1 美元。
model MailPack {
  id         Int            @id @default(autoincrement())
  credits    Int
  priceCents Int
  currency   String         @default("USD")
  active     Boolean        @default(true)
  sort       Int            @default(0)
  purchases  MailPurchase[]
}

model ShopMailBalance {
  shop      String   @id
  allowance Int
  used      Int      @default(0)
  updatedAt DateTime @updatedAt
}

model MailPurchase {
  id         Int      @id @default(autoincrement())
  shop       String
  packId     Int
  pack       MailPack @relation(fields: [packId], references: [id])
  credits    Int
  priceCents Int
  currency   String
  chargeGid  String   @unique
  status     String
  applied    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
}

// 每一封实际交给邮件服务的信，记一个收件人。
model MailDelivery {
  id           Int         @id @default(autoincrement())
  shop         String
  subscriberId Int?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  email        String
  sentAt       DateTime    @default(now())

  @@index([shop, sentAt])
  @@index([shop, email])
  @@index([subscriberId])
}

model CustomerDataRequest {
  id               Int       @id @default(autoincrement())
  shop             String
  email            String
  shopifyRequestId String?
  found            Boolean
  subscribedAt     DateTime?
  createdAt        DateTime  @default(now())

  @@index([shop, createdAt])
}
