// 线上 MariaDB。本地开发用 prisma/schema.prisma（SQLite），不要用这个文件跑 pnpm dev。
// 生成与迁移：pnpm run setup:production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?   @db.Text
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?   @db.VarChar(254)
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?   @db.Text
  refreshTokenExpires DateTime?
}

model Subscriber {
  id            Int            @id @default(autoincrement())
  shop          String
  email         String         @db.VarChar(254)
  receivedCount Int            @default(0)
  createdAt     DateTime       @default(now())
  deliveries    MailDelivery[]

  @@unique([shop, email])
}

model ShopSender {
  shop      String   @id
  fromName  String   @default("")
  fromEmail String   @db.VarChar(254)
  updatedAt DateTime @updatedAt
}

// 每个店铺只能绑定一个发件域名。更换必须先删除再添加。
model ShopDomain {
  shop      String   @id
  resendId  String   @db.VarChar(64)
  name      String   @unique @db.VarChar(253)
  status    String   @db.VarChar(32)
  region    String   @db.VarChar(32)
  records   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  key   String @id @db.VarChar(64)
  value String @db.VarChar(32)
}

model MailPack {
  id         Int            @id @default(autoincrement())
  credits    Int
  priceCents Int
  currency   String         @default("USD") @db.VarChar(3)
  active     Boolean        @default(true)
  sort       Int            @default(0)
  purchases  MailPurchase[]
}

model ShopMailBalance {
  shop      String   @id @db.VarChar(191)
  allowance Int
  used      Int      @default(0)
  updatedAt DateTime @updatedAt
}

model MailPurchase {
  id         Int      @id @default(autoincrement())
  shop       String   @db.VarChar(191)
  packId     Int
  pack       MailPack @relation(fields: [packId], references: [id])
  credits    Int
  priceCents Int
  currency   String   @db.VarChar(3)
  chargeGid  String   @unique @db.VarChar(128)
  status     String   @db.VarChar(32)
  applied    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
}

model MailDelivery {
  id           Int         @id @default(autoincrement())
  shop         String      @db.VarChar(191)
  subscriberId Int?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  email        String      @db.VarChar(254)
  sentAt       DateTime    @default(now())

  @@index([shop, sentAt])
  @@index([shop, email])
  @@index([subscriberId])
}

model CustomerDataRequest {
  id               Int       @id @default(autoincrement())
  shop             String
  email            String    @db.VarChar(254)
  shopifyRequestId String?   @db.VarChar(64)
  found            Boolean
  subscribedAt     DateTime?
  createdAt        DateTime  @default(now())

  @@index([shop, createdAt])
}
